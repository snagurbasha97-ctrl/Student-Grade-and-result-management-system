
# Student Result & Grade Management System
# Developed using Python

students = {}

# Calculate total, percentage and grade
def calculate_result(marks):
    total = sum(marks)
    maximum = len(marks) * 100
    percentage = (total / maximum) * 100

    if any(mark < 35 for mark in marks):
        grade = "Fail"
    elif percentage >= 90:
        grade = "A+"
    elif percentage >= 80:
        grade = "A"
    elif percentage >= 70:
        grade = "B"
    elif percentage >= 60:
        grade = "C"
    elif percentage >= 50:
        grade = "D"
    else:
        grade = "E"

    return total, percentage, grade


# Get valid marks
def get_marks():
    marks = []
    n = int(input("Enter number of subjects: "))

    if n <= 0:
        print("Number of subjects must be positive.")
        return None

    for i in range(n):
        while True:
            try:
                mark = float(input(
                    f"Enter marks for Subject {i+1} (0-100): "
                ))

                if 0 <= mark <= 100:
                    marks.append(mark)
                    break
                else:
                    print("Marks must be between 0 and 100.")

            except ValueError:
                print("Please enter valid numeric marks.")

    return marks


# Add student
def add_student():
    roll = input("Enter Roll Number: ").strip()

    if not roll:
        print("Roll number cannot be empty.")
        return

    if roll in students:
        print("Student already exists!")
        return

    name = input("Enter Student Name: ").strip()
    if not name:
        print("Name cannot be empty.")
        return

    marks = get_marks()

    if marks is None:
        return

    students[roll] = {
        "name": name,
        "marks": marks
    }

    print("Student added successfully!")


# Update student
def update_student():
    roll = input("Enter Roll Number to update: ").strip()

    if roll not in students:
        print("Student not found!")
        return

    print("1. Update Name")
    print("2. Update Marks")

    choice = input("Enter your choice: ")

    if choice == "1":
        name = input("Enter New Name: ").strip()
        if name:
            students[roll]["name"] = name
            print("Name updated successfully!")
        else:
            print("Name cannot be empty.")

    elif choice == "2":
        marks = get_marks()
        if marks is not None:
            students[roll]["marks"] = marks
            print("Marks updated successfully!")

    else:
        print("Invalid choice!")


# Display student result
def display_student(roll):
    student = students[roll]
    total, percentage, grade = calculate_result(
        student["marks"]
    )

    print("\n------ STUDENT RESULT ------")
    print("Roll Number :", roll)
    print("Name        :", student["name"])
    print("Marks       :", student["marks"])
    print("Total Marks :", total)
    print("Percentage  :", round(percentage, 2), "%")
    print("Grade       :", grade)
    print("----------------------------")


# Search student
def search_student():
    roll = input("Enter Roll Number to search: ").strip()

    if roll in students:
        display_student(roll)
    else:
        print("Student not found!")


# View all students
def view_students():
    if not students:
        print("No student records available.")
        return

    for roll in students:
        display_student(roll)


# Performance summary
def performance_summary():
    if not students:
        print("No records available.")
        return

    total_students = len(students)
    passed = 0
    failed = 0
    total_percentage = 0

    for roll, student in students.items():
        total, percentage, grade = calculate_result(
            student["marks"]
        )

        total_percentage += percentage

        if grade == "Fail":
            failed += 1
        else:
            passed += 1

    average = total_percentage / total_students

    print("\n===== PERFORMANCE SUMMARY =====")
    print("Total Students :", total_students)
    print("Passed Students:", passed)
    print("Failed Students:", failed)
    print("Average Percentage:",
          round(average, 2), "%")
    print("================================")


# Main menu
def main():
    while True:
        print("\n===== STUDENT RESULT MANAGEMENT =====")
        print("1. Add Student")
        print("2. Update Student")
        print("3. Search Student")
        print("4. View All Students")
        print("5. Performance Summary")
        print("6. Exit")

        choice = input("Enter your choice (1-6): ")

        if choice == "1":
            add_student()

        elif choice == "2":
            update_student()

        elif choice == "3":
            search_student()

        elif choice == "4":
            view_students()

        elif choice == "5":
            performance_summary()

        elif choice == "6":
            print("Thank you for using the system!")
            break

        else:
            print("Invalid choice! Please try again.")


# Program execution
if __name__ == "__main__":
    main()
